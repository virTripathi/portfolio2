# --- Server ---
PORT=4000
# Comma-separated list of allowed CORS origins (your web app).
CORS_ORIGINS=http://localhost:3000

# --- Contact form email (SMTP) ---
# Leave SMTP_* empty in development: submissions are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where contact emails are delivered (defaults to SMTP_USER).
CONTACT_TO=
# From address shown on the email (defaults to SMTP_USER).
CONTACT_FROM=

# --- GitHub stats (optional) ---
# A classic/fine-grained token with public read access raises the rate limit.
GITHUB_TOKEN=
